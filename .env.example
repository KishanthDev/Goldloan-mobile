# ====================================================================
# Goldora - Environment Configuration Template
# Copy this file to .env and replace with your deployment values.
# ====================================================================

# Google Apps Script Web App Deployment URL (ends in /exec)
EXPO_PUBLIC_GAS_API_URL=https://script.google.com/macros/s/YOUR_APPS_SCRIPT_DEPLOYMENT_ID/exec

# Google Spreadsheet ID (from your Google Sheet URL)
EXPO_PUBLIC_SPREADSHEET_ID=YOUR_SPREADSHEET_ID_HERE

# Branding & Localization
EXPO_PUBLIC_APP_NAME=Goldora
EXPO_PUBLIC_APP_SUBTITLE=Bangalore Gold Valuation System
EXPO_PUBLIC_LOCATION_BENCHMARK=Bangalore

# Baseline Gold Rates (Fallback if offline, ₹ per 1g)
EXPO_PUBLIC_FALLBACK_24K_RATE=8850
EXPO_PUBLIC_FALLBACK_22K_RATE=8115
EXPO_PUBLIC_FALLBACK_18K_RATE=6640

# Loan Defaults
EXPO_PUBLIC_DEFAULT_INTEREST_RATE=1.5
EXPO_PUBLIC_DEFAULT_LOAN_PERIOD=12 Months
EXPO_PUBLIC_MAX_LTV_PERCENT=75
