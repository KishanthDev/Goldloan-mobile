# ==============================================================================
# GOLD LOAN TRACKER - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Duplicate this file to .env and adjust variables to match your environment.
# ==============================================================================

# Google Apps Script Web App Deployment URL
EXPO_PUBLIC_GAS_API_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Google Spreadsheet ID
EXPO_PUBLIC_SPREADSHEET_ID=YOUR_SPREADSHEET_ID

# Offline Mock Mode (true / false)
EXPO_PUBLIC_FORCE_MOCK_MODE=false

# Branding & Title
EXPO_PUBLIC_APP_NAME=Gold Loan Tracker
EXPO_PUBLIC_APP_SUBTITLE=Bangalore Gold Valuation System
EXPO_PUBLIC_LOCATION_BENCHMARK=Bangalore

# Baseline Gold Rates (₹ per 1g)
EXPO_PUBLIC_FALLBACK_24K_RATE=8850
EXPO_PUBLIC_FALLBACK_22K_RATE=8115
EXPO_PUBLIC_FALLBACK_18K_RATE=6640

# Loan Defaults
EXPO_PUBLIC_DEFAULT_INTEREST_RATE=1.5
EXPO_PUBLIC_DEFAULT_LOAN_PERIOD=12 Months
EXPO_PUBLIC_MAX_LTV_PERCENT=75
